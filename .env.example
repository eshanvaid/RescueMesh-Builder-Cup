# Copy to .env or export; no secrets here.
RESCUEMESH_STORE=sqlite
RESCUEMESH_DB=local-demo/rescuemesh.db
RESCUEMESH_MISSION=synthetic-flood-01
RESCUEMESH_TRUST_FILE=local-demo/trust.json
RESCUEMESH_AUTH_FILE=local-demo/auth.json
# Only for local development; production rejects local coordinator authentication.
RESCUEMESH_LOCAL_AUTH=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLIENT_ID=
COORDINATOR_EMAILS=
# On Cloud Run use ADC from runtime service account, never a downloaded key.
